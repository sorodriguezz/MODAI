# IP publicada por Compose: 127.0.0.1 solo este equipo; 0.0.0.0 para clientes de la red local.
MODAI_BIND_IP=127.0.0.1
MODAI_PORT=8787
# Token de instalación y credencial admin de recuperación. Largo y aleatorio (openssl rand -hex 32).
MODAI_API_TOKEN=
# Nombre con el que Caddy publica HTTPS en el puerto 8443 (compose.lan.yaml).
MODAI_HOSTNAME=modai.local

# Vacío: SQLite en el volumen de datos. Ejemplos:
# MODAI_DATABASE_URL=postgres://modai:clave@postgres:5432/modai
# MODAI_DATABASE_URL=mysql://modai:clave@mysql:3306/modai
# MODAI_DATABASE_URL=sqlserver://modai:clave@sqlserver:1433/modai?encrypt=true
MODAI_DATABASE_URL=

# optional, signed o trusted; solo trusted garantiza quién publica y exige registrar antes sus claves.
MODAI_SIGNATURE_POLICY=optional
MODAI_ARTIFACT_QUOTA_BYTES=1073741824
# Intentos de inicio de sesión por minuto e IP.
# MODAI_LOGIN_RATE_LIMIT=10

# Dirección que usan los clientes, visible en /health y en el panel.
# LAN HTTP: http://192.168.1.20:8787; LAN TLS: https://modai.local:8443
MODAI_PUBLIC_URL=
# Dominio con DNS hacia este host y puertos 80/443 abiertos (npm run docker:public).
MODAI_PUBLIC_HOST=

# Primera cuenta del panel, solo si aún no hay usuarios. Contraseña de al menos 10 caracteres.
MODAI_ADMIN_USERNAME=
MODAI_ADMIN_PASSWORD=

# true, número de saltos o IP/CIDR. Los overlays con Caddy ya la activan; actívala con Tailscale serve o Cloudflare Tunnel.
MODAI_TRUST_PROXY=false

# Raspberry Pi (compose.raspberry.yaml): imagen ya construida opcional, límite de memoria y heap de Node.
# MODAI_IMAGE=ghcr.io/sorodriguezz/modai:<versión>
MODAI_MEMORY_LIMIT=768m
MODAI_NODE_HEAP_MB=384
