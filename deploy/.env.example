# Copia este archivo a deploy/.env y reemplaza el token antes de levantar el servidor.
# Para clientes LAN por HTTP cambia 127.0.0.1 a 0.0.0.0.
# Con el overlay TLS, Caddy publica HTTPS en el puerto 8443.
MODAI_BIND_IP=127.0.0.1
MODAI_PORT=8787
MODAI_API_TOKEN=cambia-este-token
MODAI_HOSTNAME=modai.local
