# Copia este archivo a deploy/.env y reemplaza el token antes de levantar el servidor.
# Para clientes LAN por HTTP cambia 127.0.0.1 a 0.0.0.0.
# Con el overlay TLS, Caddy publica HTTPS en el puerto 8443.
MODAI_BIND_IP=127.0.0.1
MODAI_PORT=8787
MODAI_API_TOKEN=
MODAI_HOSTNAME=modai.local

# optional, signed o trusted; trusted exige registrar primero las claves de publicadores.
MODAI_SIGNATURE_POLICY=optional
MODAI_ARTIFACT_QUOTA_BYTES=1073741824

# Dirección que usarán los clientes, visible en /health y en el panel.
# LAN HTTP: http://192.168.1.20:8787; LAN TLS: https://modai.local:8443
MODAI_PUBLIC_URL=
# Para npm run docker:public, dominio con DNS hacia este host (puertos 80/443).
MODAI_PUBLIC_HOST=
