{
  "version": "0.11.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepack": "npm run build -w @modai/contracts && npm run build -w @modai/sdk && npm run build -w @modai/core && npm run build"
  },
  "name": "@sorodriguez/modai",
  "description": "CLI, agentes y puente MCP de MODAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorodriguezz/MODAI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/sorodriguezz/MODAI#readme",
  "bugs": {
    "url": "https://github.com/sorodriguezz/MODAI/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "modai": "dist/bin/modai.js",
    "modai-mcp": "dist/bin/modai-mcp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package-source": "./dist/authoring/package-source.js"
  },
  "devDependencies": {
    "@modai/contracts": "0.11.0",
    "@modai/core": "0.11.0",
    "@modai/sdk": "0.11.0",
    "esbuild": "^0.28.2"
  }
}
