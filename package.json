{
  "name": "modularai",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "ModularAI: registro local, contexto, memoria y CLI para capacidades de IA componibles.",
  "bin": {
    "modai": "dist/src/cli/index.js",
    "modai-mcp": "dist/src/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node --no-warnings dist/src/server.js",
    "mcp": "node --no-warnings dist/src/mcp.js",
    "cli": "tsx src/cli/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "seed:examples": "tsx scripts/seed-examples.ts",
    "docker:up": "node scripts/deploy.mjs up -d --build",
    "docker:down": "node scripts/deploy.mjs down",
    "docker:logs": "node scripts/deploy.mjs logs -f server",
    "docker:ps": "node scripts/deploy.mjs ps",
    "docker:seed": "node scripts/deploy.mjs --profile examples run --rm seed-examples",
    "docker:lan": "node scripts/deploy.mjs --lan up -d --build"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
